# Local-machine environments and tool state
.venv-drift/
.claude/
__pycache__/
*.pyc

# MLflow tracking store (SQLite binary + run artifacts) -- regenerated locally by
# train.py/retrain.py; in CI this is restored/saved via actions/cache instead of git,
# since a binary SQLite file has no meaningful diff/merge in version control.
mlflow.db
mlruns/

# Regenerated pipeline outputs -- not source, safe to recreate by re-running the scripts
feature_importance.png
reports/
chroma_db/

# Redundant copy of the public dataset (same data as data/telco_customer_churn_raw.xlsx)
archive.zip
/data/telco_features.parquet
